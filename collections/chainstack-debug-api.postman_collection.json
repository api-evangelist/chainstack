              "content": "Retrieves all possible chain heads (leaves of fork choice tree). This endpoint provides insight into the current fork choice state by returning all potential chain heads that the beacon node is tracking.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "getDebugBeaconHeadsV2"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Your Chainstack node identifier",
                  "type": "any",
                  "value": "{{node_id}}",
                  "key": "node_id"
                },
                {
                  "description": "Per-node access key",
                  "type": "any",
                  "value": "{{api_key}}",
                  "key": "api_key"

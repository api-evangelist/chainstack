                  "key": "Content-Type",
                  "value": "application/json"
                },
                {
                  "disabled": false,
                  "description": {
                    "content": "(Required) The active consensus version to which the data belongs. Required in response so client can deserialize returned JSON or SSZ data more effectively.",
                    "type": "text/plain"
                  },
                  "key": "Eth-Consensus-Version",
                  "value": "bellatrix"
                }
              ],
              "cookie": [],
              "responseTime": null,
